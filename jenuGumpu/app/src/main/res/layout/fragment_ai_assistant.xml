<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/Text_Hero"
            android:text="GenAI Business Guide" />

        <TextView
            style="@style/Text_Body"
            android:layout_marginTop="6dp"
            android:text="Enter your skill, location, and starting budget to receive a practical self-employment idea." />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/InputBox"
            android:layout_marginTop="18dp"
            android:hint="Skill">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/skillInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/InputBox"
            android:hint="Location">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/locationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/InputBox"
            android:hint="Budget in rupees">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/budgetInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Generate Plan"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/aiResult"
            style="@style/Text_Result"
            android:layout_marginTop="18dp"
            android:text="Your AI-generated plan will appear here." />

    </LinearLayout>
</ScrollView>
