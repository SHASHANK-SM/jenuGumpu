<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="@drawable/bg_hero_card"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/dashboard_title"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_honey_market" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text_HeroLight"
                    android:text="@string/dashboard_title" />

                <TextView
                    style="@style/Text_BodyLight"
                    android:layout_marginTop="6dp"
                    android:text="@string/dashboard_subtitle" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.cardview.widget.CardView
                style="@style/MetricCard"
                android:layout_width="0dp"
                android:layout_weight="1">

                <LinearLayout
                    style="@style/CardInner"
                    android:background="@drawable/bg_metric_income"
                    android:orientation="vertical">
                    <TextView style="@style/Text_LabelLight" android:text="Harvested Honey" />
                    <TextView style="@style/Text_MetricLight" android:text="105 L" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/MetricCard"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1">

                <LinearLayout
                    style="@style/CardInner"
                    android:background="@drawable/bg_metric_orders"
                    android:orientation="vertical">
                    <TextView style="@style/Text_LabelLight" android:text="Cart Orders" />
                    <TextView style="@style/Text_MetricLight" android:text="18" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            style="@style/Text_Section"
            android:layout_marginTop="22dp"
            android:text="Honey Batch Highlights" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/opportunityList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
